# WireGuard VPN の設定値（docs/wireguard.md のシェル変数に対応）
#
# このファイルを site.env にコピーして値を書き換え、両拠点の WG ホストに同じ内容を置く。
#   cp site.env.example site.env
# site.env は .gitignore で除外している（環境固有の値をコミットしないため）。
# 例の値は手順書の検証で使ったもの。

# --- 各拠点の LAN（重複不可） ---------------------------------------------
SITE_A_LAN=192.168.110.0/24         # <SITE_A_LAN>
SITE_B_LAN=192.168.120.0/24         # <SITE_B_LAN>

# --- 各拠点ルーターの LAN 側 IP（router コマンドの表示にだけ使う。空でもよい） ---
ROUTER_A_LAN_IP=192.168.110.1       # <ROUTER_A_LAN_IP>
ROUTER_B_LAN_IP=192.168.120.1       # <ROUTER_B_LAN_IP>

# --- 各 WG ホストの LAN 側 IP（固定にする） ----------------------------------
# スクリプトはこの IP を持つホストかどうかを確認し、A/B の取り違えを防ぐ
WG_A_LAN_IP=192.168.110.2           # <WG_A_LAN_IP>
WG_B_LAN_IP=192.168.120.2           # <WG_B_LAN_IP>

# --- 各拠点ルーターのグローバル IP または DDNS 名 ------------------------------
# 着信を受けられない拠点（CGNAT など）は空にする。空にした拠点に向けた Endpoint は
# 書かれない（その拠点からトンネルを張る）。両方を空にはできない。
SITE_A_PUBLIC=198.51.100.1          # <SITE_A_PUBLIC>
SITE_B_PUBLIC=198.51.100.2          # <SITE_B_PUBLIC>

# --- トンネル ------------------------------------------------------------------
WG_TUNNEL_NET=10.99.0.0/30          # <WG_TUNNEL_NET>
WG_A_TUN_IP=10.99.0.1               # <WG_A_TUN_IP>
WG_B_TUN_IP=10.99.0.2               # <WG_B_TUN_IP>
WG_PORT=51820                       # <WG_PORT>

# --- firewalld -----------------------------------------------------------------
# WG ホストの LAN 側 NIC が属するゾーン。wg0 もこのゾーンに入れ、ゾーン内転送（forward）を
# 有効にする（policy は作らない）。空なら WG_x_LAN_IP を持つ NIC から自動で検出する
LAN_ZONE=                           # <LAN_ZONE>

# --- 公開鍵（keygen の出力を書く） ----------------------------------------------
# 自拠点の分は空でも動く（鍵ファイルから算出する）。相手拠点の分は必須。
# WG_USE_EXISTING_CONF=1 のときは不要。
SITE_A_PUBKEY=                      # <SITE_A_PUBKEY>
SITE_B_PUBKEY=                      # <SITE_B_PUBKEY>

# --- リモートクライアント（docs/wireguard.md の手順 2。クライアントを受ける拠点に書く） -------
# 各拠点に接続するクライアントに割り当てるトンネル内のアドレス帯（/30 またはそれより広く）。
# LAN・WG_TUNNEL_NET・もう一方の帯と重複不可。クライアントを受けない拠点は空にする。
# 拠点 A のクライアントは拠点 A のホストに接続し、拠点 B の LAN へはトンネル経由で届く。
WG_A_CLIENT_NET=10.99.1.0/24        # <WG_A_CLIENT_NET>
WG_B_CLIENT_NET=                    # <WG_B_CLIENT_NET>  例: 10.99.2.0/24
# クライアント用 conf に書く DNS サーバー（空なら DNS = を書かない）
WG_CLIENT_DNS=                      # <WG_CLIENT_DNS>    例: 192.168.110.1
# 登録簿とクライアント用 conf の置き場所（通常は変えない）
# WG_CLIENTS_FILE=<site.env と同じディレクトリ>/clients.list   # client add が追記する。形式は clients.list.example
# WG_CLIENT_DIR=/etc/wireguard/clients                          # client add が <NAME>.conf を 0600 で書く

# --- 任意設定 ------------------------------------------------------------------
# 1 にすると既存の /etc/wireguard/<WG_IFACE>.conf をそのまま使い、生成しない
# （コマンドラインの --use-existing-conf と同じ）
WG_USE_EXISTING_CONF=0
WG_IFACE=wg0
WG_FW_ZONE=wireguard                # 旧レイアウト（専用ゾーン + policy）で wg0 を入れていたゾーン名。残っていれば apply / remove が消す。通常は変えない
WG_KEEPALIVE=25                     # 0 で PersistentKeepalive を書かない（クライアント用 conf にも同じ値を書く）
WG_MTU=                             # 空なら wg-quick が出口の NIC の MTU から 80 を引く（1500 なら 1420）。値を書くとクライアント用 conf にも同じ値を書く。PPPoE などの回線は docs/wireguard.md「回線に合わせて MTU を下げる」
