# WireGuard 拠点間 VPN の設定値（docs/wireguard-site-to-site.md のプレースホルダに対応）
#
# このファイルを site.env にコピーして値を書き換え、両拠点の WG ホストに同じ内容を置く。
#   cp site.env.example site.env
# site.env は .gitignore で除外している（環境固有の値をコミットしないため）。
# 例の値は手順書の検証で使ったもの。

# --- 各拠点の LAN（重複不可） ---------------------------------------------
SITE_A_LAN=192.168.110.0/24         # <SITE_A_LAN>
SITE_B_LAN=192.168.120.0/24         # <SITE_B_LAN>

# --- 各拠点ルーターの LAN 側 IP（router コマンドの表示にだけ使う。空でもよい） ---
ROUTER_A_LAN_IP=192.168.110.1       # <ROUTER_A_LAN_IP>
ROUTER_B_LAN_IP=192.168.120.1       # <ROUTER_B_LAN_IP>

# --- 各 WG ホストの LAN 側 IP（固定にする） ----------------------------------
# スクリプトはこの IP を持つホストかどうかを確認し、A/B の取り違えを防ぐ
WG_A_LAN_IP=192.168.110.2           # <WG_A_LAN_IP>
WG_B_LAN_IP=192.168.120.2           # <WG_B_LAN_IP>

# --- 各拠点ルーターのグローバル IP または DDNS 名 ------------------------------
# 着信を受けられない拠点（CGNAT など）は空にする。空にした拠点に向けた Endpoint は
# 書かれない（その拠点からトンネルを張る）。両方を空にはできない。
SITE_A_PUBLIC=198.51.100.1          # <SITE_A_PUBLIC>
SITE_B_PUBLIC=198.51.100.2          # <SITE_B_PUBLIC>

# --- トンネル ------------------------------------------------------------------
WG_TUNNEL_NET=10.99.0.0/30          # <WG_TUNNEL_NET>
WG_A_TUN_IP=10.99.0.1               # <WG_A_TUN_IP>
WG_B_TUN_IP=10.99.0.2               # <WG_B_TUN_IP>
WG_PORT=51820                       # <WG_PORT>

# --- firewalld -----------------------------------------------------------------
# WG ホストの LAN 側 NIC が属するゾーン。空なら WG_x_LAN_IP を持つ NIC から自動で検出する
LAN_ZONE=                           # <LAN_ZONE>

# --- 公開鍵（keygen の出力を書く） ----------------------------------------------
# 自拠点の分は空でも動く（鍵ファイルから算出する）。相手拠点の分は必須。
# WG_USE_EXISTING_CONF=1 のときは不要。
SITE_A_PUBKEY=                      # <SITE_A_PUBKEY>
SITE_B_PUBKEY=                      # <SITE_B_PUBKEY>

# --- 任意設定 ------------------------------------------------------------------
# 1 にすると既存の /etc/wireguard/<WG_IFACE>.conf をそのまま使い、生成しない
# （コマンドラインの --use-existing-conf と同じ）
WG_USE_EXISTING_CONF=0
WG_IFACE=wg0
WG_FW_ZONE=wireguard                # wg0 を入れる firewalld ゾーン名
WG_KEEPALIVE=25                     # 0 で PersistentKeepalive を書かない
WG_MTU=                             # 空なら wg-quick の既定（1420）
